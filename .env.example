# Copy to .env and fill in. Never commit .env.

# Required for real runs. Leave empty and set SCHOLARPATH_FAKE_LLM=1 to run offline.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: enables the Searcher's live web search tool.
TAVILY_API_KEY=

# 1 = use the deterministic offline model (no network, no keys).
SCHOLARPATH_FAKE_LLM=0

# Optional overrides.
# SCHOLARPATH_CATALOG=data/opportunities.json
# SCHOLARPATH_REPORTS_DIR=reports
